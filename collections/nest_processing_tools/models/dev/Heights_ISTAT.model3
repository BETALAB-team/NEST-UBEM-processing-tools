        </Option>
        <Option name="GLOBAL" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="def addHeight(key,value,height):&#xa;    valuecheck=1&#xa;    if value == None:&#xa;        valuecheck=None&#xa;    else:&#xa;        section_data=dict(zip(key,value))&#xa;        Height_keys=[&quot;P[1F]&quot;,&quot;P[2F]&quot;,&quot;P[3F]&quot;,&quot;P[4F+]&quot;]&#xa;        Height_data=[section_data[h] for h in Height_keys]&#xa;        floors=Height_data.index(max(Height_data))+1&#xa;    if height==None:&#xa;        if valuecheck==None:&#xa;            inheight=None&#xa;        else:&#xa;            inheight=3.5*floors&#xa;    else:&#xa;        inheight=height &#xa;    return inheight"/>
          </Option>
        </Option>
